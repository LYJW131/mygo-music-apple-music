{
  "name": "mygo-music-apple-music",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "node scripts/build.ts",
    "package": "node scripts/package.ts",
    "helper": "node scripts/helper.ts --here",
    "test:helper": "cd helper && go vet ./... && go test ./...",
    "typecheck": "tsc -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && node --experimental-vm-modules --test tests/*.test.ts",
    "test:live": "npm run build && node --experimental-vm-modules tests/live.ts",
    "test:e2e": "node scripts/e2e.ts",
    "test:signed-in": "npm run build && node --experimental-vm-modules tests/signed-in.ts",
    "test:live-write": "node tests/live-write.ts",
    "check": "npm run typecheck && npm run format:check && npm test && npm run test:helper && npm run package"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
